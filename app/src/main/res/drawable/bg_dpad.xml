<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="50%p"
                android:startColor="#332F6BFF" android:centerColor="#1A8B5CFF" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#1B2250" android:endColor="#0E1330" />
            <stroke android:width="1.5dp" android:color="#3A4580" />
        </shape>
    </item>
</layer-list>
