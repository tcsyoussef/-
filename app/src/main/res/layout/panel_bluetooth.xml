<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bluetoothPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_help"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/bt_not_connected"
        android:textColor="@color/accent_amber"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBtDiscoverable"
            style="@style/RemoteButton"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/bt_make_visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBtRefresh"
            style="@style/RemoteButton.Accent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/bt_paired_list" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btDeviceList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
