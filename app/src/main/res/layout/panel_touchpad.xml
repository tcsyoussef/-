<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/touchpadPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/touchpad_help"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <com.irremote.tv.input.TouchpadView
        android:id="@+id/touchpadView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPadBack"
            style="@style/RemoteButton"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPadOk"
            style="@style/RemoteButton.Accent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/ok" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPadHome"
            style="@style/RemoteButton"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/home" />
    </LinearLayout>
</LinearLayout>
