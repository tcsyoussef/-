<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wifiPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wifi_help"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/wifiStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/wifi_not_connected"
        android:textColor="@color/accent_amber"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/wifiIpInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_spinner"
        android:hint="@string/wifi_ip_hint"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWifiScan"
            style="@style/RemoteButton"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/wifi_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWifiConnect"
            style="@style/RemoteButton.Accent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/wifi_connect" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWifiLast"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAllCaps="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/wifiScanResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/wifiDeviceList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
