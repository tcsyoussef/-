<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/connect_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/connect_subtitle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input_field"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheetTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheetTabWifi"
                    style="@style/TabButton"
                    android:text="@string/link_wifi"
                    app:icon="@drawable/ic_wifi" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheetTabBt"
                    style="@style/TabButton"
                    android:text="@string/link_bluetooth"
                    app:icon="@drawable/ic_bluetooth" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheetTabIr"
                    style="@style/TabButton"
                    android:text="@string/link_ir"
                    app:icon="@drawable/ic_ir" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </FrameLayout>

        <TextView
            android:id="@+id/sheetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/warning"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Wi‑Fi -->
        <LinearLayout
            android:id="@+id/wifiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wifi_hint" />

            <LinearLayout
                android:id="@+id/searchingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/wifi_searching"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wifiDeviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/wifiEmpty"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wifi_none"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchAgain"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="@string/search_again"
                app:icon="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/btnShowIp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/enter_ip"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/ipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/ipInput"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:digits="0123456789."
                    android:hint="@string/ip_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="number|numberDecimal"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_faint"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIpConnect"
                    style="@style/PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/connect" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bluetooth -->
        <LinearLayout
            android:id="@+id/btSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btSteps"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bt_steps" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBtVisible"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/bt_make_visible"
                app:icon="@drawable/ic_bluetooth" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/bt_paired_label" />

            <LinearLayout
                android:id="@+id/btDeviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btEmpty"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bt_none_paired"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Infrared -->
        <LinearLayout
            android:id="@+id/irSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/irText"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ir_hint" />

            <TextView
                android:id="@+id/irBrandLabel"
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/brand_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/irBrandGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseIr"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:text="@string/use_ir"
                app:icon="@drawable/ic_ir" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
