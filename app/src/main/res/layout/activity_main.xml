<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent_teal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/usbStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_usb_ir_untested"
            android:textColor="@color/accent_amber"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/brand_label"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/brandSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp" />

        <TextView
            android:id="@+id/lastCommandText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/no_command_yet"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/disclaimer"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPower"
            style="@style/RemoteButton.Power"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/power" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/RemoteButton"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/mute" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInput"
                style="@style/RemoteButton"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/input" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolDown"
                style="@style/RemoteButton"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/vol_down" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolUp"
                style="@style/RemoteButton"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/vol_up" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChDown"
                style="@style/RemoteButton"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/ch_down" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChUp"
                style="@style/RemoteButton"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/ch_up" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:rowCount="3"
            android:useDefaultMargins="true">

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUp"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="@string/up" />

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeft"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="@string/left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOk"
                style="@style/RemoteButton.Accent"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="@string/ok" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRight"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="@string/right" />

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDown"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="@string/down" />

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                style="@style/RemoteButton"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/menu" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/RemoteButton"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/RemoteButton"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/back" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/numberPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn5"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn6"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn7"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn8"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn9"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="9" />

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn0"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="0" />

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
