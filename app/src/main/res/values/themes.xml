<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IrTvRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryVariant">@color/bg_panel</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSecondary">@color/accent_amber</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="RemoteButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/button_fill</item>
        <item name="strokeColor">@color/button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="RemoteButton.Power">
        <item name="backgroundTint">@color/accent_red</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="RemoteButton.Accent">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/bg_deep</item>
    </style>
</resources>
